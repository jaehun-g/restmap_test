{
  "name": "next-map-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mts",
    "e2e:facility-map": "node scripts/run-facility-map-e2e.mjs",
    "e2e:food-menu": "node node_modules/next/dist/bin/next build && node scripts/run-playwright-e2e.mjs e2e/kakao-map-zoom.spec.ts --grep \"mobile rest-area details\"",
    "e2e:visual": "node node_modules/next/dist/bin/next build && node scripts/run-playwright-e2e.mjs",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,css,html}\"",
    "db:import-highway-route": "node scripts/import-highway-route.mjs",
    "db:merge-highway-route-alias": "node scripts/merge-highway-route-alias.mjs",
    "db:setup-ex-station-geocodes": "node scripts/create-ex-station-geocodes-table.mjs",
    "db:setup-ex-station-geocode-overrides": "node scripts/create-ex-station-geocode-overrides-table.mjs",
    "db:setup-food-menus": "node scripts/setup-food-menu-tables.mjs",
    "sync:food-menus": "node scripts/sync-food-menus.mjs",
    "db:upsert-ex-station-geocode-overrides": "node scripts/upsert-ex-station-geocode-overrides.mjs",
    "sync:ex-station-geocodes": "node scripts/sync-ex-station-geocodes.mjs",
    "sync:ex-stations": "node scripts/sync-ex-station-geocodes.mjs --apply"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "mysql2": "3.24.5",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
