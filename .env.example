# Browser-visible JavaScript key, not a REST API or Admin key.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Server-only REST API key used by Kakao Local address geocoding.
KAKAO_REST_API_KEY=

# Server-only Korea Expressway Corporation Open API key for curStateStation.
EX_OPEN_API_KEY=

# Server-only Supabase Transaction Pooler URL (port 6543, sslmode=require).
DATABASE_URL=

# Server-only administrator password. Leave blank to keep editing locked.
ADMIN_PASSWORD=
