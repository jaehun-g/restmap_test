# Browser-visible JavaScript key, not a REST API or Admin key.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Server-only Cafe24 MariaDB credentials.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Set true only if your database supports TLS with a trusted certificate.
DB_SSL=false

# Server-only administrator password. Leave blank to keep editing locked.
ADMIN_PASSWORD=
